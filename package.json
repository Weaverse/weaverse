{
  "name": "weaverse-sdks",
  "description": "Weaverse SDKs monorepo.",
  "version": "5.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*",
    "templates/*"
  ],
  "scripts": {
    "dev": "pnpm run dev:pkg",
    "dev:pkg": "cross-env LOCAL_DEV=true FORCE_CHANGELOG_SOURCE=remote turbo dev --no-daemon --filter=./packages/*",
    "clean": "bash ./scripts/clean.sh",
    "upgrade-packages": "bash ./scripts/upgrade-packages.sh",
    "update-deps": "bash ./scripts/update-deps.sh",
    "test": "turbo run test",
    "test:run": "vp test --run --bail=1",
    "build": "turbo run build --filter=./packages/*",
    "build:graph": "turbo run build --graph=repo-graph.svg",
    "api:docs:test": "node --test scripts/public-api-docs.test.mjs scripts/public-api-model.test.mjs",
    "api:report": "pnpm run api:docs:test && pnpm run build && node scripts/api-reports.mjs --update",
    "api:check": "pnpm run api:docs:test && pnpm run build && node scripts/api-reports.mjs",
    "package:check": "pnpm run api:docs:test && pnpm run build && node scripts/api-reports.mjs && node scripts/check-packed-packages.mjs",
    "postinstall": "lefthook install",
    "typecheck": "turbo run typecheck --filter=./packages/*",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "check:fix:unsafe": "vp check --fix-dangerously",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "ci": "vp check"
  },
  "devDependencies": {
    "@jridgewell/gen-mapping": "0.3.13",
    "@jridgewell/trace-mapping": "0.3.31",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "lefthook": "2.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.4",
    "turbo": "2.11.12",
    "tsrs": "7.1.0-beta.tsrs2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@esbuild/darwin-x64": "0.28.2",
    "turbo-darwin-arm64": "2.8.17"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
