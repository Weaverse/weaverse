{
  "root": true,
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/remix",
    "./packages/biome/biome.json"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main",
    "root": "."
  },
  "files": {
    "includes": [
      "!**/dist",
      "!**/build",
      "!**/.turbo",
      "!**/templates",
      "!**/archived",
      "!**/package-lock.json",
      "!**/app/styles/app.css",
      "!**/packages/biome"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedPackageJson": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "style": {
        "noExcessiveClassesPerFile": "warn",
        "useConsistentMethodSignatures": "warn",
        "useDestructuring": "warn",
        "useErrorCause": "warn",
        "useImportsFirst": "warn",
        "useNamedCaptureGroup": "warn",
        "useThisInClassMethods": "warn",
        "useUnicodeRegex": "off"
      },
      "suspicious": {
        "noConsole": "off",
        "noEqualsToNull": "warn",
        "noImportCycles": "off"
      },
      "correctness": {
        "noComponentHookFactories": "warn",
        "noUndeclaredDependencies": "off",
        "noUnusedInstantiation": "warn"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noUselessReturn": "off"
      },
      "performance": {
        "noAwaitInLoops": "off"
      },
      "nursery": {}
    }
  }
}
