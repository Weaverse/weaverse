{
  "name": "@weaverse/react",
  "author": "Weaverse Team",
  "description": "React bindings for Weaverse",
  "version": "5.23.0",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/types/index.d.ts",
  "module": "dist/index.mjs",
  "repository": {
    "url": "git+https://github.com/Weaverse/weaverse.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public",
    "@weaverse:registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vp pack src/index.ts --format esm --format cjs --sourcemap --no-fixed-extension --no-dts --watch --on-success 'node ../../scripts/build-declarations.mjs'",
    "build": "vp pack src/index.ts --format esm --format cjs --sourcemap --no-fixed-extension --no-dts && node ../../scripts/build-declarations.mjs",
    "clean": "rimraf dist",
    "test": "vp test --run",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@weaverse/core": "5.23.0",
    "@weaverse/schema": "0.19.0",
    "clsx": "^2.1.1",
    "react": ">=19",
    "react-dom": ">=19"
  }
}
