{
  "name": "@weaverse/core",
  "author": "Weaverse Team",
  "description": "Weaverse Core",
  "version": "5.24.0",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "module": "dist/index.mjs",
  "repository": {
    "url": "git+https://github.com/Weaverse/weaverse.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "@weaverse:registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vp pack --watch --on-success 'node ../../scripts/build-declarations.mjs'",
    "build": "vp pack && node ../../scripts/build-declarations.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsrs --noEmit",
    "test": "vp test --run"
  }
}
