{
  "name": "@weaverse/hydrogen",
  "author": "Weaverse Team",
  "description": "Components, hooks, and utilities for building Shopify Hydrogen websites with Weaverse",
  "version": "5.24.0",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/types/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./react-router": {
      "types": "./dist/types/react-router.d.ts",
      "import": "./dist/react-router.mjs",
      "require": "./dist/react-router.js"
    },
    "./internal": {
      "types": "./dist/types/internal.d.ts",
      "import": "./dist/internal.mjs",
      "require": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "@weaverse:registry": "https://registry.npmjs.org"
  },
  "repository": {
    "url": "git+https://github.com/Weaverse/weaverse.git",
    "directory": "packages/hydrogen"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vp pack src/index.ts src/react.ts src/react-router.ts src/internal.ts --format esm --format cjs --sourcemap --no-fixed-extension --no-dts --watch --on-success 'node ../../scripts/build-declarations.mjs'",
    "build": "vp pack src/index.ts src/react.ts src/react-router.ts src/internal.ts --format esm --format cjs --sourcemap --no-fixed-extension --no-dts && node ../../scripts/build-declarations.mjs",
    "clean": "rimraf dist",
    "test": "vp test --run",
    "typecheck": "tsrs --noEmit"
  },
  "peerDependencies": {
    "@shopify/hydrogen": ">=2026.10.0"
  },
  "devDependencies": {
    "@shopify/hydrogen": "^2026.10.2"
  },
  "dependencies": {
    "@weaverse/react": "5.24.0",
    "@weaverse/schema": "0.19.0",
    "react": ">=19",
    "react-dom": ">=19",
    "react-error-boundary": "^6",
    "react-router": "^7"
  }
}
